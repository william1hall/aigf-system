# AI 女友系统环境变量配置
# 复制此文件为 .env 并填入你自己的值

# 火山引擎（豆包图片生成）
VOLC_API_KEY=your-volcengine-api-key

# 飞书
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_USER_ID=your-feishu-open-id

# QQ Bot
QQ_OPENID=your-qq-openid

# MiniMax（用于自动生成情话）
MINIMAX_API_KEY=your-minimax-api-key

# 服务器公网 IP（QQ 图片中转用）
SERVER_IP=your-server-public-ip
SERVER_PORT=8080
